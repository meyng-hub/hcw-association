# Stripe
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Email (Resend)
RESEND_API_KEY=re_...

# Site
NEXT_PUBLIC_SITE_URL=https://www.h-cw.org

# Newsletter (Brevo/Sendinblue)
BREVO_API_KEY=xkeysib-...

# Analytics (Plausible — no personal data)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=h-cw.org

# Maintenance mode — set MAINTENANCE_MODE=true (+ redeploy) to show the
# branded 503 "under maintenance" page to all visitors. Owner can still view
# the real site via https://www.h-cw.org/fr?bypass=<MAINTENANCE_BYPASS_TOKEN>
# (sets a 24h cookie). Leave unset/false for normal operation.
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_TOKEN=change-me
